{
  "expo": {
    "name": "IPTV Neo",
    "slug": "iptv-neo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090E",
    "splash": {
      "backgroundColor": "#07090E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iptvneo.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "38e3764c-094f-4617-b131-fa28c1c6ee66"
      }
    }
  }
}
